# API Keys
GROQ_API_KEY=your_groq_api_key_here

# Database
CACHE_DB_PATH=./output/cache.sqlite

# Model Selection Config (Optional overrides)
LLM_MODEL=openai/gpt-oss-120b
SLM_PROVIDER=ollama
SLM_OLLAMA_MODEL=qwen3.5:4b
SLM_GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_HOST=http://localhost:11434

# Generation settings
SLM_MAX_TOKENS=1024
LLM_MAX_TOKENS=320
SELF_CONSISTENCY_K=3

# Default Verifier Settings
HEADLINE_STRICTNESS=4
